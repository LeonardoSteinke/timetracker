# Nome do container (usado no docker-compose e como hostname no nginx)
PROJECT_NAME=timetracker

# Porta interna que a aplicação escuta (não publicada no host)
APP_PORT=3000

# Subdomínio usado pelo proxy reverso (ex.: timetracker.seudominio.com.br)
SUBDOMAIN=timetracker

# Rede Docker externa onde vive o proxy reverso.
# Irrelevante se você publicar a porta direto no docker-compose.yml.
PROXY_NETWORK=media_server_media_net

# Fuso horário padrão da aplicação
TZ=America/Sao_Paulo

# ─── Segredos (gerar valores fortes!) ────────────────────────────────────────
# Assina os JWT de sessão. Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-valor-aleatorio-forte

# Código que cria ADMIN MASTER no cadastro (quem administra os usuários).
# Os demais entram por convite gerado dentro do app, não por este código.
REGISTRATION_CODE=defina-um-codigo-de-convite

# ─── Notificações push (opcional) ────────────────────────────────────────────
# Não precisa preencher: na primeira boot o app gera o par de chaves e guarda em
# data/vapid.json. Defina aqui só se preferir gerenciar o segredo pelo .env
# (gere com: npx web-push generate-vapid-keys). Trocar as chaves derruba todas
# as assinaturas já feitas nos aparelhos.
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
# Contato exigido pelo padrão VAPID. Este vale a pena definir: a Apple recusa o
# push (403 BadJwtToken) se não for um mailto de domínio real ou uma URL https —
# sem ele funciona no Android e falha no iPhone.
VAPID_SUBJECT=mailto:voce@seudominio.com.br
